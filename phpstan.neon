parameters:
    level: 5
    phpVersion: 80100
    # PHPDoc types describe the intended contract; runtime values reaching these
    # guards can come from events and external input, so they are not certain.
    treatPhpDocTypesAsCertain: false
    tmpDir: /tmp/phpstan/ApiReference/main
    paths:
        - .
    excludePaths:
        - tests/*
        - vendor/*
        - github-action-tests/ (?)
        - scoper.inc.php
        - Specs/SpecGenerator.php
    bootstrapFiles:
        - phpstan-bootstrap.php
        - ../../bootstrap-phpstan.php
    universalObjectCratesClasses:
        - Piwik\Config
        - Piwik\View
        - Piwik\ViewDataTable\Config
    scanDirectories:
        # ../../ does not actually seem to give us anything
        # that ../plugins/ does not, but including it for
        # completeness.  It does not seem to slow down performance.
        - .

